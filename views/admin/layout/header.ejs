<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TECH ADMIN</title>
  <link rel="icon" type="image/png" href="/img/letter-z.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root { --sidebar-width: 260px; }
    body { background: #f8f9fa; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .sidebar {
      width: var(--sidebar-width);
      height: 100vh;
      position: fixed;
      top: 0; left: 0;
      background: #212529;
      color: white;
      padding-top: 20px;
      z-index: 1000;
      overflow-y: auto;
    }
    .sidebar .brand {
      font-size: 1.35rem;
      font-weight: 700;
      padding: 0 20px 25px;
      letter-spacing: 1px;
    }
    .sidebar a {
      color: #adb5bd;
      text-decoration: none;
      padding: 12px 20px;
      display: block;
      transition: 0.2s;
      border-left: 3px solid transparent;
    }
    .sidebar a:hover,
    .sidebar a.active {
      color: #fff;
      background: #343a40;
      border-left-color: #0d6efd;
    }
    .sidebar i {
      width: 25px;
      text-align: center;
      margin-right: 10px;
    }
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 25px 30px;
      min-height: 100vh;
    }
  </style>
</head>
<body>
<div class="sidebar">
  <div class="brand">TECH ADMIN</div>

  <a href="/admin/statistics" class="<%= typeof active !== 'undefined' && active === 'statistics' ? 'active' : '' %>">
    <i class="fas fa-chart-bar"></i> Thống kê
  </a>

  <a href="/admin/products" class="<%= typeof active !== 'undefined' && active === 'products' ? 'active' : '' %>">
    <i class="fas fa-box"></i> Sản phẩm
  </a>

  <a href="/admin/categories" class="<%= typeof active !== 'undefined' && active === 'categories' ? 'active' : '' %>">
    <i class="fas fa-list"></i> Danh mục
  </a>

  <a href="/admin/orders" class="<%= typeof active !== 'undefined' && active === 'orders' ? 'active' : '' %>">
    <i class="fas fa-shopping-cart"></i> Đơn hàng
  </a>

  <a href="/admin/reviews" class="<%= typeof active !== 'undefined' && active === 'reviews' ? 'active' : '' %>">
    <i class="fas fa-star"></i> Đánh giá
  </a>

  <a href="/admin/discount" class="<%= typeof active !== 'undefined' && active === 'discount' ? 'active' : '' %>">
    <i class="fas fa-percentage"></i> Giảm giá (Sale)
  </a>

  <a href="/admin/setting" class="<%= typeof active !== 'undefined' && active === 'setting' ? 'active' : '' %>">
    <i class="fas fa-cog"></i> Cấu hình
  </a>

  <a href="/logout" style="color:#ff6b6b; margin-top: 30px;">
    <i class="fas fa-sign-out-alt"></i> Đăng xuất
  </a>
</div>

<div class="main-content">