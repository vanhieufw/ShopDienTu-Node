<%- include('./layout/header', { active: 'products' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0 text-primary"><i class="fas fa-percentage me-2"></i> Quản Lý Giảm Giá Sản Phẩm</h3>
  <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-arrow-left"></i> Quay lại danh sách
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th width="100">Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th width="160" class="text-center">Giá bán</th>
            <th width="140" class="text-center">Giảm giá</th>
            <th width="100" class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length) { %>
            <% products.forEach(function(p) { 
              const discount = parseInt(p.Discount) || 0;
            %>
              <tr>
                <td>
                  <% if (p.ImageUrlProduct) { %>
                    <img src="/img/<%= p.ImageUrlProduct %>" style="width:60px;height:60px;object-fit:cover;border-radius:8px">
                  <% } %>
                </td>
                <td>
                  <strong><%= p.NameProduct %></strong><br>
                  <small class="text-muted">ID: <%= p.IDProduct %></small>
                </td>
                <td class="text-center fw-bold"><%= Number(p.PriceProduct).toLocaleString('vi-VN') %>đ</td>
                <td class="text-center">
                  <span class="badge <%= discount > 0 ? 'bg-success' : 'bg-secondary' %>" style="font-size:1rem;padding:8px 14px">
                    <%= discount %>%
                  </span>
                </td>
                <td class="text-center">
                  <button type="button" class="btn btn-warning btn-sm"
                          data-bs-toggle="modal" data-bs-target="#editDiscountModal"
                          data-id="<%= p.IDProduct %>"
                          data-name="<%= p.NameProduct %>"
                          data-discount="<%= discount %>">
                    <i class="fas fa-edit"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center py-5 text-muted">Chưa có sản phẩm</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal sửa giảm giá -->
<div class="modal fade" id="editDiscountModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form action="/admin/products/update-discount" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title"><i class="fas fa-percentage me-2"></i> Cập nhật giảm giá</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p><strong>Sản phẩm:</strong> <span id="modalProductName"></span></p>
          <input type="hidden" name="id" id="modalProductId">
          <div class="mb-3">
            <label class="form-label fw-bold">Phần trăm giảm giá (%)</label>
            <input type="number" name="discount" id="modalDiscount" class="form-control text-center" min="0" max="90" value="0" required>
            <small class="text-muted">Nhập 0 nếu không giảm giá</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu thay đổi</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const modal = document.getElementById('editDiscountModal');
  modal.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    document.getElementById('modalProductId').value = button.getAttribute('data-id');
    document.getElementById('modalProductName').textContent = button.getAttribute('data-name');
    document.getElementById('modalDiscount').value = button.getAttribute('data-discount');
  });
</script>
</div></body></html>