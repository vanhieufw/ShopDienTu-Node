<%- include('./layout/header', { active: 'products' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Danh sách sản phẩm</h3>
  <a href="/admin/products/create" class="btn btn-primary">
    <i class="fas fa-plus"></i> Thêm mới
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th width="80">Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th width="140">Giá bán</th>
            <th width="90">Kho</th>
            <th width="100">Danh mục</th>
            <th width="120" class="text-end">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length) { %>
            <% products.forEach(function(p) { %>
              <tr>
                <td>
                  <% if (p.ImageUrlProduct) { %>
                    <img src="/img/<%= p.ImageUrlProduct %>" style="width:50px;height:50px;object-fit:cover;border-radius:6px">
                  <% } else { %>
                    <span class="text-muted small">No img</span>
                  <% } %>
                </td>
                <td>
                  <strong><%= p.NameProduct %></strong><br>
                  <small class="text-muted">ID: <%= p.IDProduct %></small>
                </td>
                <td class="text-danger fw-bold"><%= Number(p.PriceProduct).toLocaleString('vi-VN') %>₫</td>
                <td><span class="badge bg-info text-dark"><%= p.StockQuantityProduct %></span></td>
                <td><%= p.IDCategory %></td>
                <td class="text-end">
                  <a href="/admin/products/edit?id=<%= p.IDProduct %>" class="btn btn-sm btn-outline-primary me-1">
                    <i class="fas fa-edit"></i>
                  </a>
                  <a href="/admin/products/delete?id=<%= p.IDProduct %>" class="btn btn-sm btn-outline-danger"
                     onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                    <i class="fas fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có sản phẩm nào</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</div></body></html>