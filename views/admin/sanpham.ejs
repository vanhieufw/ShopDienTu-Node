<%- include('layout/header') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Quản lý sản phẩm</h2>
  <a href="/admin/products/create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm sản phẩm</a>
</div>
<table class="table table-bordered table-hover bg-white">
  <thead class="table-dark">
    <tr>
      <th>ID</th>
      <th>Ảnh</th>
      <th>Tên</th>
      <th>Giá</th>
      <th>Tồn kho</th>
      <th>Thao tác</th>
    </tr>
  </thead>
  <tbody>
    <% (products || []).forEach(function(p) { %>
    <tr>
      <td><%= p.IDProduct %></td>
      <td>
        <% if (p.ImageUrlProduct) { %>
          <img src="/img/<%= p.ImageUrlProduct %>" alt="" style="height:50px;object-fit:cover">
        <% } else { %>
          <span class="text-muted">No img</span>
        <% } %>
      </td>
      <td><%= p.NameProduct %></td>
      <td><%= Number(p.PriceProduct).toLocaleString('vi-VN') %>đ</td>
      <td><%= p.StockQuantityProduct %></td>
      <td>
        <a href="/admin/products/edit?id=<%= p.IDProduct %>" class="btn btn-sm btn-warning">Sửa</a>
        <a href="/admin/products/delete?id=<%= p.IDProduct %>" class="btn btn-sm btn-danger"
           onclick="return confirm('Xóa sản phẩm này?')">Xóa</a>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div></body></html>
