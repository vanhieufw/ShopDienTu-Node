                                            </tr>
                                    <% } else {
                                            cartItems.forEach(function(item) {
                                                var gia_goc = Number(item.PriceProduct) || 0;
                                                var giam = (item.Discount !== undefined && item.Discount !== null) ? Number(item.Discount) : 0;
                                                var gia_moi = gia_goc * (100 - giam) / 100;
                                                var qty = Number(item.QuantityCartItem || item.Quantity || 1);
                                                var tong_tien_item = gia_moi * qty;
                                                subtotal += tong_tien_item;
                                    %>
