                                                        </a>
                                                    </td>
                                                    <td class="product-name">
                                                        <a href="/detail?id=<%= item.IDProduct %>">
                                                            <%= item.NameProduct %>
                                                        </a>
                                                        <% if (giam > 0) { %>
                                                            <span class="onsale">-<%= giam %>%</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="product-price">
                                                        <span class="amount"><strong><%= Number(gia_moi).toLocaleString('vi-VN') %> ₫</strong></span>
                                                    </td>
                                                    <td class="product-quantity">
                                                        <div class="quantity buttons_added" style="display: inline-flex; align-items: center; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
                                                            <button type="button" class="minus btn-qty" data-id="<%= item.IDProduct %>"
