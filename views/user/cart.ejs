                                                            <input type="number"
                                                                name="qty[<%= item.IDProduct %>]"
                                                                class="input-text qty text qty-input"
                                                                value="<%= qty %>"
                                                                min="1"
                                                                data-id="<%= item.IDProduct %>"
                                                                style="width:60px; text-align:center; border:none; height:40px; font-size:16px;"
                                                                readonly>
                                                            <button type="button" class="plus btn-qty" data-id="<%= item.IDProduct %>"
