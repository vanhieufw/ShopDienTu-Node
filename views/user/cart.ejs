                                                        </div>
                                                    </td>
                                                    <td class="product-subtotal">
                                                        <span class="amount"><strong><%= Number(tong_tien_item).toLocaleString('vi-VN') %> ₫</strong></span>
                                                    </td>
                                                </tr>
                                    <% }); } %>

                                    <%
